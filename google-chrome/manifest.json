{
  "name": "Jack",
  "description": "Manage temporary e-mails addresses and passwords.",
  "manifest_version": 3,
  "version": "1.32",
  "author": "Augustin LAOUAR",
  "icons": {
    "16": "icons/jack_16x16.png",
    "48": "icons/jack_48x48.png",
    "128": "icons/jack_128x128.png"
  },
  "action": {
      "default_icon": { 
        "16": "icons/jack_16x16.png",
        "48": "icons/jack_48x48.png",
        "128": "icons/jack_128x128.png"
      },
      "default_popup": "html/login.html",
      "default_title": "Jack"
  },
  "permissions": [
      "storage",
      "contextMenus",
      "activeTab",
      "alarms",
      "downloads",
      "scripting"
  ],
  "host_permissions": [
      "http://*/*",
      "https://*/*"
  ],
  "background": {
      "service_worker": "/js/background/background.js",
      "type": "module"
  },
  "content_scripts": [
      {
          "matches": ["http://*/*", "https://*/*"],
          "js": [
              "/js/content/refresh_timer.js"
          ]
      }
  ]
}
